{
  "name": "fategotbc",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "npx prisma generate",
    "prisma:dev:pull": "dotenv -e .env.development -- npx prisma db pull",
    "migration:dev": "dotenv -e .env.development -- npx prisma migrate dev",
    "migration:reset": "dotenv -e .env.development -- npx prisma migrate reset",
    "start": "dotenv -e .env.development -- node ./src/server.js",
    "test": "dotenv -e .env.production -- playwright test --config=configs/playwright.config.js",
    "lint": "eslint -c configs/eslint.config.mjs ./src/*",
    "test-trace": "npm test -- --reporter=html --trace on"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AcademicV1ctim/FateGoTBC.git"
  },
  "author": "Nathaniel Low",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AcademicV1ctim/FateGoTBC/issues"
  },
  "homepage": "https://github.com/AcademicV1ctim/FateGoTBC#readme",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "http-errors": "^2.0.0",
    "node": "^23.11.0"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.17.1"
  }
}
